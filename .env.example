# ============================================================================
# Restaurant Growth Audit — unified single-repo build.
# The V3 competitor engine is BUILT IN (no separate deployment needed).
# Everything degrades gracefully: set what you have, ship, add the rest later.
# ============================================================================

# --- REQUIRED: Google (one key, "Places API (New)" + "PageSpeed Insights API") ---
# Accepts either name; set one.
GOOGLE_PLACES_API_KEY=
# GOOGLE_MAPS_API_KEY=            # (alias — only needed if you prefer this name)

# --- REQUIRED for reviews: Outscraper (Google reviews provider) ---
OUTSCRAPER_API_KEY=

# --- REQUIRED for social: SocialCrawl (public social activity) ---
SOCIALCRAWL_API_KEY=

# --- AI provider (provider-agnostic, credit-ready) --------------------------
# Powers BOTH the report's interpretation AND the competitor engine's semantic
# scoring. With NO key, everything still works — report renders, competitors
# still return (labeled "Limited evidence"). Turn AI on by setting these:
#   AI_PROVIDER = openai | anthropic
#   AI_API_KEY  = <a funded key>
#   AI_MODEL    = gpt-4o (openai) | claude-3-5-sonnet-latest (anthropic)
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
# Back-compat: used only if AI_* above are unset.
OPENAI_API_KEY=

# --- OPTIONAL: base URL (helps the built-in engine call itself server-side) ---
# Set to your deployment URL, e.g. https://your-app.vercel.app
# If unset, Vercel's own VERCEL_URL is used automatically. Localhost in dev.
NEXT_PUBLIC_BASE_URL=

# --- OPTIONAL: competitor engine override -----------------------------------
# Leave BLANK — the engine is built in. Only set this to point at a different
# external engine deployment (not needed in the unified build).
COMPETITOR_ENGINE_URL=

# --- OPTIONAL: shareable report links (Firebase Firestore) ------------------
# If unset, the report still renders fully — only the shareable /r/{id} link
# is skipped (the save is non-fatal). Set all three to enable it.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- OPTIONAL: lead capture (GoHighLevel) -----------------------------------
# If unset, lead capture no-ops silently.
GHL_PIT_TOKEN=
GHL_LOCATION_ID=
LEAD_WEBHOOK_URL=
LEAD_SUBMIT_SECRET=

# --- OPTIONAL: CSRF origin allowlist (leave unset = same-origin only) --------
ALLOWED_ORIGINS=
